# ── Supabase ──────────────────────────────────────────────────────────────
# Create a project at https://supabase.com (owned by Sikamine, not the developer).
# Project Settings → API for these values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: server-only, NEVER expose to the browser / NEXT_PUBLIC_*.
# Used for admin-invite and storage signed-URL generation.
SUPABASE_SERVICE_ROLE_KEY=

# ── SMTP (Sikamine-owned mailbox, e.g. Hostinger) ───────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME="Sikamine Gold Trading Ltd"
SMTP_FROM_EMAIL=

# ── Site ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
